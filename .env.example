# Local operator config for Spiro / UIE.
# Copy to `.env` (gitignored) and edit paths for your machine:
#   cp .env.example .env
#
# Scripts source this via `scripts/load-dotenv.sh`.
# Do not put secrets that must leave the laptop in committed files.
# Prefer DI-owned injectables for product knobs; this file is for host/operator lanes.

# --- Acceptance / live ---
# UIE_ACCEPTANCE_MODE=ci
# UIE_ACCEPTANCE_MODE=live
# UIE_ACCEPTANCE_FEATURES=gguf,live-onnx
# UIE_ACCEPTANCE_RUN_STUBS_IN_LIVE=1
# UIE_LIVE_REQUIRE_LMSTUDIO=1
# SPIRO_MODEL_ROOTS=$PWD/config/model_roots.yaml
# UIE_LIVE_MODEL_PATH=$HOME/.lmstudio/models/publisher/repo/model.gguf

# --- MNIST ONNX (US-009 / US-026) ---
# UIE_MNIST_MODEL=$PWD/models/mnist-8.onnx
# UIE_MNIST_FIXTURE=$PWD/models/fixtures/digit_one_f32.bin

# --- Browser Qwen GGUF demo (US-026 opt-in) ---
# SPIRO_QWEN_MODEL=$HOME/.lmstudio/models/Qwen/Qwen3-0.6B-GGUF/Qwen3-0.6B-Q8_0.gguf
# PORT=18766

# --- E2E / pipelines ---
# UIE_ARTIFACT_DIR=/tmp/uie-artifacts
# UIE_E2E_MOCK_MODELS=1
# UIE_IMAGE_PROMPT=A simple blue square on a white background, flat graphic.
# UIE_LLM_FOLLOWUP=0
# UIE_QWEN_VL_REGISTRY_ID=lmstudio:…/model.gguf
# UIE_QWEN_VL_GGUF=$HOME/.lmstudio/models/…/model.gguf
# UIE_QWEN_VL_MMPROJ=$HOME/.lmstudio/models/…/mmproj.gguf
# UIE_GGUF_MODEL=$HOME/.lmstudio/models/…/model.gguf

# --- Serve / IPC (when used) ---
# UIE_SOCKET=/tmp/uie.sock
# UIE_ACCEPTANCE_SOCKET=/tmp/uie-acceptance.sock
# UIE_SERVE_PROFILE=dev
